# Copy to .env and fill in. .env is gitignored — never commit a real key.
#   cp .env.example .env

# Kimi (Moonshot AI). Get a key at https://platform.moonshot.ai/
# Use api.moonshot.cn instead of api.moonshot.ai if your account is the CN one.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2-0905-preview

# Anthropic, optional — the same tools run on Claude with FEHU_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Which provider the generators use by default: kimi | claude
FEHU_PROVIDER=kimi
